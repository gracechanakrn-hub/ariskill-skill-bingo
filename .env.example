# AriSkill Skill Bingo - local AI tooling keys. Copy to `.env` and fill in. `.env` is git-ignored.
# Only tools/ai/* read these; the game service never loads them and no key is ever sent to a browser.

# Google AI Studio key (https://aistudio.google.com/apikey) - Gemini image models for visual exploration.
GEMINI_API_KEY=
# OpenAI key (https://platform.openai.com/api-keys) - copywriting (CW) proposals and UX/UI template proposals.
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# OPENAI_TEXT_MODEL=gpt-5.1
# OPENAI_IMAGE_MODEL=gpt-image-2
# BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
