  "rules": {
    "semanticColourNeverAlone": "Core/Critical/Optional and success/warning/danger states always carry a label and/or icon; colour is never the only signal.",
    "coreCriticalIcons": {
      "core": "filled diamond + text label 'Core'",
      "critical": "filled circle + text label 'Critical'",
      "optional": "outlined circle + text label 'Optional'"
    },
    "contrast": {
      "text": 4.5,
      "largeTextAndUi": 3
    },
    "venueMinimums": {
      "bodyPx": 40,
      "headlinePx": 96,
      "viewingDistanceM": [
        10,
        25
      ],
      "resolution": "1920x1080"
    },
    "sticker": {
      "pill": "pill labels use --sticker-badge fill with --sticker-badge-ink text (>= 4.5:1) and a 2 px --sticker-outline stroke; type is --font-display, uppercase, weight 600-700",
      "limeLabel": "text on --sticker-aurora-lime is always --sticker-navy (dark navy on lime), never white",
      "dieCut": "every Soul, badge and doodad gets the --sticker-outline (6 px at a 240 px Soul, scales with size) and --sticker-shadow",
      "nonRanking": "no level, tier or score label appears on or near a Soul (BR-17); the only badge is the Bingo Star",
      "bodyText": "body text stays >= 4.5:1 on every tile surface; --sticker-* colours are decorative and never the only signal"
    }
  }
